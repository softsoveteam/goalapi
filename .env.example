APP_NAME=SOFTSOVE Portal API
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# aaPanel PostgreSQL — replace USER, PASSWORD, DBNAME
# Host is 127.0.0.1 if the API runs on the same server
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@127.0.0.1:5432/DBNAME

# Add your Next.js domain in production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-admin-domain.com

SEED_ADMIN_EMAIL=admin@softsove.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=SOFTSOVE Owner
